# docker-compose.yml 使用的变量。复制为 .env.docker 后填入下面生成的值：
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# 注意：不要把本文件复制成 .env。根目录的 .env 是应用自身的配置文件，
# 只接受 Settings 中已定义的字段，出现 POSTGRES_PASSWORD 会导致启动失败。

# PostgreSQL 密码，任意强随机字符串：
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# 账号凭据的加密主密钥，必须是 32 字节的 URL-safe base64（解码后长度需为 32）：
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
PLACEGAME_MASTER_KEY_B64=

# MCP 静态 Bearer 令牌，必须是 43 位 URL-safe 字符：
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
PLACEGAME_MCP_TOKEN=

# 管理会话 cookie 是否只在 HTTPS 下发送。通过 http://127.0.0.1:18080 访问时保持
# false，否则无法登录；部署到 HTTPS 域名后改为 true。
PLACEGAME_ADMIN_COOKIE_SECURE=false

# 宿主机监听端口，仅绑定 127.0.0.1。端口被占用时改成别的值。
PLACEGAME_HTTP_PORT=18080
